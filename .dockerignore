# Ignore host-created storage symlink/junction that breaks Docker build context on Windows
public/storage
public/hot
vendor
node_modules

.git
.idea
.vscode
.env
docs
docker-compose*.yaml

# Lokale Laufzeitdaten nicht ins Image kopieren
bootstrap/cache/*.php
storage/logs/*
storage/debugbar/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/.app_key
